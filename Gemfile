source "https://rubygems.org"

# GitHub Pages 互換のJekyllとプラグインを一括管理
gem "github-pages", group: :jekyll_plugins

# ローカルプレビュー時のWebrickなど
gem "webrick", "~> 1.8"

# Ruby3.4.0以降でjekyllを使用するためのgem
gem "csv"
gem "bigdecimal"

# Windows環境でのタイムゾーン情報を提供するためのgem:w
gem "tzinfo-data"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end
